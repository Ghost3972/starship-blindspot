<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/camera_bg">

    <!-- 录制界面（横屏：左侧4个纵向小视图 + 右侧主视图） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- 左侧：4个小预览视图（纵向排列） + 按钮区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.25"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp"
            android:background="@color/camera_panel_bg">

            <!-- 小视图区域（纵向排列：前-后-左-右） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <!-- 前视角 -->
                <FrameLayout
                    android:id="@+id/frame_front"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@color/camera_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextureView
                        android:id="@+id/texture_front"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/label_front"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:text="前"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <!-- 选中高亮边框 -->
                    <View
                        android:id="@+id/highlight_front"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/camera_highlight_border"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 后视角 -->
                <FrameLayout
                    android:id="@+id/frame_back"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@color/camera_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextureView
                        android:id="@+id/texture_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/label_back"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:text="后"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/highlight_back"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/camera_highlight_border"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 左视角 -->
                <FrameLayout
                    android:id="@+id/frame_left"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@color/camera_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextureView
                        android:id="@+id/texture_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/label_left"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:text="左"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/highlight_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/camera_highlight_border"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- 右视角 -->
                <FrameLayout
                    android:id="@+id/frame_right"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:background="@color/camera_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextureView
                        android:id="@+id/texture_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/label_right"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/camera_label_background"
                        android:gravity="center"
                        android:text="右"
                        android:textColor="@color/white"
                        android:textSize="10sp" />

                    <View
                        android:id="@+id/highlight_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/camera_highlight_border"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- 按钮区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <!-- 录制按钮 -->
                <Button
                    android:id="@+id/btn_record"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:text="●"
                    android:textSize="24sp"
                    android:backgroundTint="@color/camera_btn_bg"
                    android:textColor="#FF0000"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <ImageButton
                    android:id="@+id/btn_photo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_photo_capture"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:backgroundTint="@color/camera_btn_bg"
                    android:elevation="4dp"
                    android:contentDescription="抓帧"
                    style="?android:attr/borderlessButtonStyle" />

            </LinearLayout>
        </LinearLayout>

        <!-- 右侧：主预览视图 -->
        <FrameLayout
            android:id="@+id/frame_main"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.75"
            android:background="@color/camera_bg"
            android:clickable="true"
            android:focusable="true">

            <TextureView
                android:id="@+id/texture_main"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- 主视图标签 -->
            <TextView
                android:id="@+id/label_main"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/camera_label_background"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="全景"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <!-- 点击提示 -->
            <TextView
                android:id="@+id/hint_tap_to_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/camera_label_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="点击恢复全景"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- 录制状态显示（右上角） -->
    <LinearLayout
        android:id="@+id/recording_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/camera_label_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <!-- 录制指示灯 -->
        <View
            android:id="@+id/recording_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/recording_dot" />

        <!-- 录制时间 -->
        <TextView
            android:id="@+id/tv_recording_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</FrameLayout>
