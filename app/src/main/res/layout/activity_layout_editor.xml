<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/card_background"
        android:elevation="2dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="← 返回"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_secondary"
            android:stateListAnimator="@null"
            android:paddingHorizontal="20dp" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="画面区域配置"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="保存"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:paddingHorizontal="28dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_background"
        android:layout_marginTop="1dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="输出分辨率：未知"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_front"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="前"
                android:textSize="20sp"
                android:textColor="@color/button_accent"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btn_back_view"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="后"
                android:textSize="20sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btn_left"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="左"
                android:textSize="20sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btn_right"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="右"
                android:textSize="20sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="重置"
                android:textSize="18sp"
                android:textColor="@color/danger_text"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null"
                android:paddingHorizontal="20dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/camera_bg"
        android:layout_margin="12dp">

        <ImageView
            android:id="@+id/image_full"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="@color/camera_bg" />

        <com.elliot.blindspot.CropOverlayView
            android:id="@+id/crop_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:text="拖动框体移动位置 · 拖动右下角调整大小"
            android:textColor="@color/overlay_light_text"
            android:textSize="14sp"
            android:background="@color/overlay_dark"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

    </FrameLayout>

</LinearLayout>
