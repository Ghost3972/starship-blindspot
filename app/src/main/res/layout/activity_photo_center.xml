<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:text="返回"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_secondary"
                android:stateListAnimator="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="录制设置/回放"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="36dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_tab_settings"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:text="设置"
                android:textSize="30sp"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary"
                android:layout_marginEnd="18dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btn_tab_album"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:text="回放"
                android:textSize="30sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/btn_secondary"
                android:layout_marginStart="18dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/layout_settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_background"
                    android:padding="48dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="录制帧率（FPS）"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="录制会按帧率持续抓帧并写入 MOV（MJPEG）。帧率越高占用越高，建议从 5fps 开始测试，帧率过高可能导致车机卡顿。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <EditText
                        android:id="@+id/et_record_fps"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:inputType="number"
                        android:hint="例如：10"
                        android:textSize="27sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="18dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="MOV 分片时长（秒）"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="录制会按分片时长生成多个 MOV 文件，默认 10 秒一个分片。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <EditText
                        android:id="@+id/et_segment_sec"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:inputType="number"
                        android:hint="例如：10"
                        android:textSize="27sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="18dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:background="@color/divider_color"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="存储位置"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="默认存到内置存储 DCIM/E02REC。选择U盘时会在目标位置创建 E02REC 文件夹。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <Spinner
                        android:id="@+id/sp_store_mode"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/spinner_background"
                        android:spinnerMode="dropdown"/>

                    <EditText
                        android:id="@+id/et_usb_path"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:hint="/storage/XXXX-XXXX"
                        android:inputType="text"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="18dp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tv_store_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="默认：DCIM/E02REC"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:background="@color/divider_color"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="文件夹大小上限（MB，0=不限）"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="超过上限后自动删除最老分片直到回到阈值。建议至少 500MB。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <EditText
                        android:id="@+id/et_limit_mb"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:inputType="number"
                        android:hint="例如：2048"
                        android:textSize="27sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="18dp"/>

                    <Button
                        android:id="@+id/btn_cleanup_now"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:text="立即清理到上限内"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"/>

                    <TextView
                        android:id="@+id/tv_folder_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="当前占用：--"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <Button
                        android:id="@+id/btn_refresh_stats"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:text="刷新占用统计"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:background="@color/divider_color"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="输出参数"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="质量/最大宽度会影响占用与清晰度。一般推荐：质量85 + 最大宽度2560。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <Spinner
                            android:id="@+id/sp_format"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:spinnerMode="dropdown"
                            android:layout_marginEnd="18dp"/>

                        <EditText
                            android:id="@+id/et_max_width"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:hint="最大宽度"
                            android:inputType="number"
                            android:textSize="24sp"
                            android:textColor="@color/text_primary"
                            android:background="@drawable/spinner_background"
                            android:paddingHorizontal="18dp"
                            android:layout_marginStart="18dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="压缩质量：85"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <SeekBar
                        android:id="@+id/sb_quality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="抓帧方式"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="OpenGL优先使用GPU离屏抓拍，性能更好；TextureView兼容性更强但占用更高。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <Spinner
                        android:id="@+id/sp_capture_source"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/spinner_background"
                        android:spinnerMode="dropdown"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:background="@color/divider_color"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动开启"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="可选：补盲服务启动后自动开始录制（会留2秒缓冲再开始）。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <Switch
                        android:id="@+id/sw_auto_on_service"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="服务启动后自动录制"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:background="@color/divider_color"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="录制状态悬浮窗"
                        android:textSize="30sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="开启后在屏幕上显示录制状态图标。点击图标会跳转到主页。录制开启时会柔和闪烁提示。"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <Switch
                        android:id="@+id/sw_photo_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="显示录制悬浮窗"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tv_overlay_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="大小：96dp"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <SeekBar
                        android:id="@+id/sb_overlay_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="240"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tv_overlay_alpha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="透明度：70%"
                        android:textSize="24sp"
                        android:textColor="@color/text_secondary"/>

                    <SeekBar
                        android:id="@+id/sb_overlay_alpha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:layout_marginTop="6dp"/>

                    <Button
                        android:id="@+id/btn_save_settings"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="36dp"
                        android:text="保存设置"
                        android:textSize="30sp"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_primary"
                        android:stateListAnimator="@null"/>

                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:id="@+id/layout_album"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_refresh_album"
                        android:layout_width="wrap_content"
                        android:layout_height="72dp"
                        android:text="刷新"
                        android:textSize="24sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/btn_secondary"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_timeline"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:background="@color/page_background"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.7"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:background="@drawable/card_background">

                            <TextView
                                android:id="@+id/tv_playback_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="请选择左侧视频"
                                android:textSize="24sp"
                                android:textColor="@color/text_primary"
                                android:singleLine="true"
                                android:ellipsize="middle"/>

                            <Button
                                android:id="@+id/btn_play"
                                android:layout_width="wrap_content"
                                android:layout_height="60dp"
                                android:text="播放"
                                android:textSize="24sp"
                                android:textColor="@color/text_primary"
                                android:background="@drawable/btn_secondary"
                                android:stateListAnimator="@null"/>

                            <Button
                                android:id="@+id/btn_pause"
                                android:layout_width="wrap_content"
                                android:layout_height="60dp"
                                android:layout_marginStart="12dp"
                                android:text="暂停"
                                android:textSize="24sp"
                                android:textColor="@color/text_primary"
                                android:background="@drawable/btn_secondary"
                                android:stateListAnimator="@null"/>

                            <Button
                                android:id="@+id/btn_stop"
                                android:layout_width="wrap_content"
                                android:layout_height="60dp"
                                android:layout_marginStart="12dp"
                                android:text="停止"
                                android:textSize="24sp"
                                android:textColor="@color/text_primary"
                                android:background="@drawable/btn_secondary"
                                android:stateListAnimator="@null"/>
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/sb_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:max="100"
                            android:progress="0"/>

                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:layout_marginTop="12dp"
                            android:columnCount="2"
                            android:rowCount="2">

                            <ImageView
                                android:id="@+id/iv_front"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_margin="6dp"
                                android:background="@color/black"
                                android:scaleType="centerCrop"/>

                            <ImageView
                                android:id="@+id/iv_back"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_margin="6dp"
                                android:background="@color/black"
                                android:scaleType="centerCrop"/>

                            <ImageView
                                android:id="@+id/iv_left"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_margin="6dp"
                                android:background="@color/black"
                                android:scaleType="centerCrop"/>

                            <ImageView
                                android:id="@+id/iv_right"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_columnWeight="1"
                                android:layout_rowWeight="1"
                                android:layout_margin="6dp"
                                android:background="@color/black"
                                android:scaleType="centerCrop"/>
                        </GridLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>
    </LinearLayout>
</FrameLayout>
